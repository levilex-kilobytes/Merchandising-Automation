SERVICE_NAME=vendor-management
NODE_ENV=development
PORT=3001
GRPC_PORT=50051
HTTP_HOST=0.0.0.0
GRPC_HOST=0.0.0.0
API_PREFIX=/api/v1
HEALTH_CHECK_PATH=/api/v1/health
DATABASE_URL=postgres://vendor_user:vendor_pass@localhost:5432/vendor_db
RABBITMQ_URL=amqp://guest:guest@localhost:5672
EVENT_EXCHANGE=mms.events
FEATURE_VENDOR_MANAGEMENT=enabled
LOG_LEVEL=debug
OUTBOX_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
