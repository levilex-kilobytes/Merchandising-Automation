SERVICE_NAME=receiving
NODE_ENV=development
PORT=3003
GRPC_PORT=50053
HTTP_HOST=0.0.0.0
GRPC_HOST=0.0.0.0
API_PREFIX=/api/v1
HEALTH_CHECK_PATH=/api/v1/health
DATABASE_URL=postgres://receiving_user:receiving_pass@localhost:5432/receiving_db
RABBITMQ_URL=amqp://guest:guest@localhost:5672
EVENT_EXCHANGE=mms.events
FEATURE_RECEIVING=enabled
LOG_LEVEL=debug
OUTBOX_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
PROCUREMENT_GRPC_URL=localhost:50052
