SERVICE_NAME=procurement
NODE_ENV=development
PORT=3002
GRPC_PORT=50052
HTTP_HOST=0.0.0.0
GRPC_HOST=0.0.0.0
API_PREFIX=/api/v1
HEALTH_CHECK_PATH=/api/v1/health
DATABASE_URL=postgres://procurement_user:procurement_pass@localhost:5432/procurement_db
RABBITMQ_URL=amqp://guest:guest@localhost:5672
EVENT_EXCHANGE=mms.events
FEATURE_PROCUREMENT=enabled
LOG_LEVEL=debug
OUTBOX_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
VENDOR_GRPC_URL=localhost:50051
