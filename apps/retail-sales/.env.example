SERVICE_NAME=retail-sales
NODE_ENV=development
PORT=3006
GRPC_PORT=50056
HTTP_HOST=0.0.0.0
GRPC_HOST=0.0.0.0
API_PREFIX=/api/v1
HEALTH_CHECK_PATH=/api/v1/health
DATABASE_URL=postgres://retail_user:retail_pass@localhost:5432/retail_sales_db
RABBITMQ_URL=amqp://guest:guest@localhost:5672
EVENT_EXCHANGE=mms.events
FEATURE_RETAIL_SALES=enabled
LOG_LEVEL=debug
OUTBOX_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
INVENTORY_GRPC_URL=localhost:50054
DEFAULT_STORE_LOCATION=Store #1
TAX_RATE=0.16
