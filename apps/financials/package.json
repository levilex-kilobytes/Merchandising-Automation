{
  "name": "@mfa/financials",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/financials/scripts/migrate.js && node dist/apps/financials/src/server.js",
    "test": "jest --passWithNoTests",
    "migrate": "node dist/apps/financials/scripts/migrate.js",
    "migrate:dev": "ts-node scripts/migrate.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.11.2",
    "@grpc/proto-loader": "^0.7.13",
    "@mfa/errors": "*",
    "@mfa/event-bus": "*",
    "@mfa/logger": "*",
    "@mfa/shared-types": "*",
    "chart.js": "^4.5.1",
    "react-chartjs-2": "^5.3.1"
  }
}
