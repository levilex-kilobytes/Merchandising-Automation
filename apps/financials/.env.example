SERVICE_NAME=financials
NODE_ENV=development
PORT=3008
GRPC_PORT=50058
HTTP_HOST=0.0.0.0
GRPC_HOST=0.0.0.0
API_PREFIX=/api/v1
HEALTH_CHECK_PATH=/api/v1/health
DATABASE_URL=postgres://finance_user:finance_pass@localhost:5432/financials_db
RABBITMQ_URL=amqp://guest:guest@localhost:5672
EVENT_EXCHANGE=mms.events
FEATURE_FINANCIALS=enabled
LOG_LEVEL=debug
OUTBOX_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
AP_DEFAULT_TERMS_DAYS=30
COGS_RATIO=0.6
