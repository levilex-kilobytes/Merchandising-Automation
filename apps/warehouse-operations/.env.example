SERVICE_NAME=warehouse-operations
NODE_ENV=development
PORT=8080
GRPC_PORT=50055
HTTP_HOST=0.0.0.0
GRPC_HOST=0.0.0.0
API_PREFIX=/api/v1
HEALTH_CHECK_PATH=/api/v1/health
DATABASE_URL=postgres://warehouse_user:warehouse_pass@localhost:5432/warehouse_db
RABBITMQ_URL=amqp://guest:guest@localhost:5672
EVENT_EXCHANGE=mms.events
FEATURE_WAREHOUSE=enabled
LOG_LEVEL=debug
OUTBOX_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
INVENTORY_GRPC_URL=localhost:50054
DEFAULT_ZONE=Z1
DEFAULT_CAPACITY=1000
