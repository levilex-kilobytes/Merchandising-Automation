{
  "name": "merchandising-funnel-automation",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "frontend/*",
    "services/*"
  ],
  "scripts": {
    "dev:vendor": "npm --workspace=@mfa/vendor-management run dev",
    "migrate:vendor": "npm --workspace=@mfa/vendor-management run migrate",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "infra:up": "docker-compose -f infrastructure/docker/docker-compose.yml up -d",
    "infra:down": "docker-compose -f infrastructure/docker/docker-compose.yml down",
    "dev:procurement": "npm --workspace=@mfa/procurement run dev",
    "migrate:procurement": "npm --workspace=@mfa/procurement run migrate",
    "dev:vendor-portal": "npm --workspace=@mfa/vendor-management-portal run dev",
    "build:vendor-portal": "npm --workspace=@mfa/vendor-management-portal run build",
    "dev:procurement-dashboard": "npm --workspace=@mfa/procurement-dashboard run dev",
    "build:procurement-dashboard": "npm --workspace=@mfa/procurement-dashboard run build",
    "dev:receiving": "npm --workspace=@mfa/receiving run dev",
    "migrate:receiving": "npm --workspace=@mfa/receiving run migrate",
    "dev:warehouse-receiving": "npm --workspace=@mfa/warehouse-receiving-app run dev",
    "build:warehouse-receiving": "npm --workspace=@mfa/warehouse-receiving-app run build",
    "dev:inventory": "npm --workspace=@mfa/inventory run dev",
    "migrate:inventory": "npm --workspace=@mfa/inventory run migrate",
    "dev:inventory-ui": "npm --workspace=@mfa/inventory-control-center run dev",
    "dev:warehouse": "npm --workspace=@mfa/warehouse-operations run dev",
    "migrate:warehouse": "npm --workspace=@mfa/warehouse-operations run migrate",
    "dev:warehouse-floor": "npm --workspace=@mfa/warehouse-floor-app run dev",
    "build:warehouse-floor": "npm --workspace=@mfa/warehouse-floor-app run build",
    "dev:pos-terminal": "npm --workspace=@mfa/pos-terminal-app run dev",
    "build:pos-terminal": "npm --workspace=@mfa/pos-terminal-app run build",
    "dev:retail-sales": "npm --workspace=@mfa/retail-sales run dev",
    "migrate:retail-sales": "npm --workspace=@mfa/retail-sales run migrate",
    "dev:sales-audit": "npm --workspace=@mfa/sales-audit run dev",
    "migrate:sales-audit": "npm --workspace=@mfa/sales-audit run migrate",
    "dev:store-manager": "npm --workspace=@mfa/store-manager-dashboard run dev",
    "build:store-manager": "npm --workspace=@mfa/store-manager-dashboard run build",
    "dev:financials": "npm --workspace=@mfa/financials run dev",
    "migrate:financials": "npm --workspace=@mfa/financials run migrate",
    "dev:finance-portal": "npm --workspace=@mfa/finance-portal run dev",
    "build:finance-portal": "npm --workspace=@mfa/finance-portal run build",
    "dev:receiving-app": "npm --workspace=@mfa/warehouse-receiving-app run dev",
    "dev:backends": "concurrently -k -n vendor,proc,rec,inv,wh,pos,audit,fin -c blue,magenta,green,cyan,white,yellow,red,gray \"npm run dev:vendor\" \"npm run dev:procurement\" \"npm run dev:receiving\" \"npm run dev:inventory\" \"npm run dev:warehouse\" \"npm run dev:retail-sales\" \"npm run dev:sales-audit\" \"npm run dev:financials\"",
    "dev:frontends": "concurrently -k -n vw,pw,rw,iw,ww,po,aw,fw -c blue,magenta,green,cyan,white,yellow,red,gray \"npm run dev:vendor-portal\" \"npm run dev:procurement-dashboard\" \"npm run dev:receiving-app\" \"npm run dev:inventory-ui\" \"npm run dev:warehouse-floor\" \"npm run dev:pos-terminal\" \"npm run dev:store-manager\" \"npm run dev:finance-portal\"",
    "dev:hub": "python3 -m http.server 5170"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pg": "^8.13.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.5",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
