{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-web.mjs",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    { "source": "/vendor/(.*)",      "destination": "/vendor/index.html" },
    { "source": "/procurement/(.*)", "destination": "/procurement/index.html" },
    { "source": "/receiving/(.*)",   "destination": "/receiving/index.html" },
    { "source": "/inventory/(.*)",   "destination": "/inventory/index.html" },
    { "source": "/warehouse/(.*)",   "destination": "/warehouse/index.html" },
    { "source": "/pos/(.*)",         "destination": "/pos/index.html" },
    { "source": "/audit/(.*)",       "destination": "/audit/index.html" },
    { "source": "/finance/(.*)",     "destination": "/finance/index.html" }
  ]
}
